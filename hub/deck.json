      "args": {
        "simulated": true,
        "worktable": "vantage.json",
        "step_delay_s": 0
      }
    },
    {
      "name": "evo",
      "import": "plr_ivoryos.legacy",
      "class": "EVO",
      "args": {
        "simulated": true,
        "deck_type": "EVO150Deck",
        "worktable": "evo.json",
        "diti_count": 0,
        "step_delay_s": 0
      }
