    {
      "name": "lh",
      "import": "plr_ivoryos.legacy",
      "class": "LiquidHandler",
      "args": {
        "simulated": true,
        "channels": 8,
        "deck_type": "STARLetDeck",
        "worktable": "lh.json",
        "step_delay_s": 0
