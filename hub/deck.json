      "args": {
        "simulated": true,
        "worktable": "flex96.json",
        "equipment": {
          "head96": "p1000_96",
          "gripper": true,
          "trash": "A3"
        }
      }
    },
    {
      "name": "star384",
      "import": "plr_ivoryos.hamilton",
      "class": "STAR",
      "args": {
        "simulated": true,
        "worktable": "star384.json",
        "equipment": {
          "head384": true
        }
      }
    }
