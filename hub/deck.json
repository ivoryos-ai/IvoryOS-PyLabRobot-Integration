{
  "format": "ivoryos-deck/1",
  "name": "plr-ivoryos: every liquid handler, simulated",
  "packages": [
    "plr-ivoryos==1.0.0b2"
  ],
  "instruments": [
    {
      "name": "star",
      "import": "plr_ivoryos.hamilton",
      "class": "STAR",
      "args": {
        "simulated": true,
        "deck_type": "STARLetDeck",
        "worktable": "star.json",
        "step_delay_s": 0
      }
    },
    {
      "name": "prep",
      "import": "plr_ivoryos.hamilton",
      "class": "Prep",
      "args": {
        "simulated": true,
        "worktable": "prep.json",
        "step_delay_s": 0
      }
    },
    {
      "name": "ot2",
      "import": "plr_ivoryos.opentrons",
      "class": "OT2",
      "args": {
        "simulated": true,
        "port": 31950,
        "worktable": "ot2.json",
        "step_delay_s": 0
      }
    },
    {
      "name": "flex",
      "import": "plr_ivoryos.opentrons",
      "class": "Flex",
      "args": {
        "simulated": true,
        "port": 31950,
        "worktable": "flex.json",
        "step_delay_s": 0
      }
    },
    {
      "name": "nimbus",
      "import": "plr_ivoryos.legacy",
      "class": "Nimbus",
      "args": {
        "simulated": true,
        "port": 2000,
        "worktable": "nimbus.json",
        "step_delay_s": 0
      }
    },
    {
      "name": "vantage",
      "import": "plr_ivoryos.legacy",
